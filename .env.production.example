# Secure settings: enter values through Vercel Environment Variables or a local mode600 env file.
APP_ENV=production
CLINICAL_DATA_MODE=synthetic
# Use a separate runtime database role with no DDL and no audit modification privileges.
# Copy the provider URL, select its pooled endpoint, and use sslmode=verify-full.
DATABASE_URL=
FRONTEND_ORIGIN=
COOKIE_SECURE=true
SESSION_SECRET=
# No DEMO_PASSWORD in production. Secrets must not be committed or sent in chat.
